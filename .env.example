# A2A Hub — example environment
# Copy to .env and adjust. All keys are optional (defaults shown).

# Application
A2A_HUB_APP_NAME=a2a-hub
A2A_HUB_LOG_LEVEL=INFO

# HTTP server (serve command)
A2A_HUB_HOST=0.0.0.0
A2A_HUB_PORT=8000

# SQLite registry (use a persistent volume path in production)
A2A_HUB_DATABASE_PATH=data/a2a_hub.db

# Seed Agent Card URLs
A2A_HUB_SEEDS_PATH=config/seeds.json

# Crawler
A2A_HUB_CRAWLER_TIMEOUT_SECONDS=30
